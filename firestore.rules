rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.email == 'zdenek.buchta@nasebanka.example'; }
    function myRole() { return get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.get('role', 'zakaznik'); }
    function deputy() { return signedIn() && myRole() == 'zastupce'; }
    function role(r) { return signedIn() && myRole() == r; }
    // Banka umí to samé co majitel, vývojář skoro všechno
    function staff() { return admin() || (signedIn() && myRole() in ['banka', 'vyvojar']); }
    // registrace schvaluje Banka, majitel, úředník, zástupce, vývojář a grafik
    function approver() { return admin() || (signedIn() && myRole() in ['banka', 'vyvojar', 'zastupce', 'grafik', 'urednik']); }
    match /accounts/{u} {
      allow read: if signedIn();
      allow create: if (request.resource.data.get('card','klasik') != 'casino_ace' || (admin() && request.auth.uid == u)) && (admin() || (signedIn() && request.auth.uid == u && request.resource.data.role == 'zakaznik'));
      allow update: if (request.resource.data.get('card','klasik') != 'casino_ace' || (admin() && request.auth.uid == u) || (resource.data.role == 'majitel' && request.resource.data.card == resource.data.card)) && (admin()
        || (staff() && resource.data.role != 'majitel' && request.resource.data.role != 'majitel')
        || (signedIn() && request.auth.uid == u && request.resource.data.role == resource.data.role
            && request.resource.data.get('pending', false) == resource.data.get('pending', false)
            && request.resource.data.get('blocked', false) == resource.data.get('blocked', false))
        || (deputy() && resource.data.role != 'majitel' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bal','tx','sav','savAt','blocked','blockWhy']))
        // úředník Banky smí u cizího účtu jen schválit/zamítnout velkou platbu (nbx.pendPay)
        || (role('urednik') && request.auth.uid != u
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nbx'])
            && request.resource.data.nbx.diff(resource.data.nbx).affectedKeys().hasOnly(['pendPay']))
        // spolumajitel firmy smí měnit jen firmu (ne název, logo, barvu a spolumajitele)
        || (signedIn() && request.auth.uid != u
            && resource.data.get('nbx', {}).get('firm', {}).get('co', []).hasAny([request.auth.uid])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nbx'])
            && request.resource.data.nbx.diff(resource.data.nbx).affectedKeys().hasOnly(['firm'])
            && request.resource.data.nbx.firm.get('n', '') == resource.data.nbx.firm.get('n', '')
            && request.resource.data.nbx.firm.get('emoji', '') == resource.data.nbx.firm.get('emoji', '')
            && request.resource.data.nbx.firm.get('color', '') == resource.data.nbx.firm.get('color', '')
            && request.resource.data.nbx.firm.get('co', []) == resource.data.nbx.firm.get('co', []))
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bal','tx']) && request.resource.data.bal > resource.data.bal)
        || (deputy() && u != request.auth.uid && resource.data.role != 'majitel' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['casinoChips','casinoTx']) && request.resource.data.casinoChips is int && request.resource.data.casinoChips >= 0)
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['casinoChips','casinoTx','bal','tx']) && request.resource.data.bal >= resource.data.bal && request.resource.data.casinoChips is int && request.resource.data.casinoChips > resource.data.get('casinoChips',0))
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['casinoChips','casinoTx']) && request.resource.data.casinoChips is int && request.resource.data.casinoChips > resource.data.get('casinoChips',0)));
      allow delete: if admin() || (staff() && resource.data.role != 'majitel') || (deputy() && resource.data.role == 'zakaznik');
    }
    // schválení registrací
    match /approvals/{u} {
      allow read: if signedIn() && (request.auth.uid == u || approver());
      allow write: if approver();
    }
    // Minecraft linking (NašeBanka mod). The page may only claim a code for its own uid;
    // codes and links themselves are written only by the bank server (Admin SDK).
    match /mcLinkClaims/{code} {
      allow create: if signedIn() && code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.keys().hasOnly(['uid','at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at is number;
    }
    match /mcLinks/{mcUuid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }
    // interní poznámky k lidem – vidí a píše jen vedení banky
    match /staffNotes/{u} {
      allow read, write: if admin() || (signedIn() && myRole() in ['banka', 'vyvojar', 'zastupce', 'urednik']);
    }
    // podepsané smlouvy z pobočky – zákazník vidí svoje, vedení všechny; nikdo je nepřepíše
    match /contracts/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || approver());
      allow create: if approver() && request.resource.data.by == request.auth.uid
        && request.resource.data.sig is string && request.resource.data.sig.size() < 300000;
      allow delete: if admin();
    }
    // vlastní šablony smluv
    match /contractTpl/{id} {
      allow read, write: if approver();
    }
    match /requests/{u} {
      allow read: if staff();
      allow write: if signedIn() && request.auth.uid == u;
    }
    match /cardDesigns/{id} {
      allow read: if signedIn();
      function validDesign() {
        let d = request.resource.data;
        return d.keys().hasAll(['name','image','dark','recipients','createdBy','updatedAt'])
          && d.keys().hasOnly(['name','image','dark','recipients','createdBy','updatedAt'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 60
          && d.image is string && d.image.size() <= 450000
          && d.image.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')
          && d.dark is bool && d.recipients is list && d.recipients.size() > 0 && d.recipients.size() <= 200
          && d.createdBy is string && d.updatedAt is number;
      }
      allow create: if (staff() || role('grafik')) && request.resource.data.createdBy == request.auth.uid && validDesign();
      allow update: if (staff() || (role('grafik') && resource.data.createdBy == request.auth.uid))
        && request.resource.data.createdBy == resource.data.createdBy && validDesign();
      allow delete: if staff();
    }
    match /appConfig/resetRuns/items/{id} { allow read, write: if admin(); }
    match /appConfig/{id} {
      allow read, write: if admin();
    }
    match /messages/{m} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn() && request.resource.data.from == request.auth.uid;
      allow update: if signedIn() && resource.data.to == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','read']);
    }
    match /announcements/{a} {
      allow read: if signedIn();
      allow create, delete: if staff();
    }
    match /logins/{name} {
      allow get: if true;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['email','uid']) && request.resource.data.uid == request.auth.uid && request.resource.data.email == request.auth.token.email;
      allow delete: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
    match /lottery/{day} {
      allow write: if admin();
      allow read: if signedIn();
      function paidForTicket() {
        return getAfter(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.bal == get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.bal - 20;
      }
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['closesAt','status','tickets'])
        && request.resource.data.status == 'open'
        && request.resource.data.closesAt > request.time.toMillis()
        && request.resource.data.tickets == [request.auth.uid]
        && paidForTicket();
      allow update: if signedIn() && resource.data.status == 'open' && (
        (request.time.toMillis() < resource.data.closesAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tickets'])
          && request.resource.data.tickets == resource.data.tickets.concat([request.auth.uid])
          && request.resource.data.tickets.size() <= 300 && paidForTicket())
        || (request.time.toMillis() >= resource.data.closesAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','winner','winnerName','prize','drawnAt'])
          && request.resource.data.status == 'drawn'
          && request.resource.data.winner in resource.data.tickets
          && request.resource.data.prize == resource.data.tickets.size() * 40)
      );
    }
    match /casinoRounds/{day} {
      allow write: if admin();
      allow read: if signedIn();
      function paidForTicket() {
        return getAfter(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.casinoChips == get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.casinoChips - 2;
      }
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['closesAt','status','tickets'])
        && request.resource.data.status == 'open'
        && request.resource.data.closesAt > request.time.toMillis()
        && request.resource.data.tickets == [request.auth.uid]
        && paidForTicket();
      allow update: if signedIn() && resource.data.status == 'open' && (
        (request.time.toMillis() < resource.data.closesAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tickets'])
          && request.resource.data.tickets == resource.data.tickets.concat([request.auth.uid])
          && request.resource.data.tickets.size() <= 300 && paidForTicket())
        || (request.time.toMillis() >= resource.data.closesAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','winner','winnerName','prize','drawnAt'])
          && request.resource.data.status == 'drawn'
          && request.resource.data.winner in resource.data.tickets
          && request.resource.data.prize == resource.data.tickets.size() * 4)
      );
    }
  }
}
